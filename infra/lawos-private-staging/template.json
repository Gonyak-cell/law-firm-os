    "HttpApiStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": { "Ref": "HttpApi" },
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "DetailedMetricsEnabled": true,
          "ThrottlingBurstLimit": 20,
          "ThrottlingRateLimit": 10
        },
        "StageName": "$default",
        "Tags": {
          "environment": "lawos-staging",
          "system": "lawos",
          "owner": { "Ref": "Owner" },
          "review": { "Ref": "ReviewDate" },
          "expiration": { "Ref": "ExpirationDate" }
        }
      }
    },
    "HttpApiInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": { "Ref": "ApiFunction" },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*" }
      }
    },
    "ApiErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "LawOS private staging API errors",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [{ "Name": "FunctionName", "Value": { "Ref": "ApiFunction" } }],
        "EvaluationPeriods": 1,
        "MetricName": "Errors",
        "Namespace": "AWS/Lambda",
        "Period": 300,
        "Statistic": "Sum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
        "Tags": [
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "DatabaseCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "LawOS private staging RDS high CPU",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [{ "Name": "DBInstanceIdentifier", "Value": { "Ref": "Database" } }],
        "EvaluationPeriods": 3,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/RDS",
        "Period": 300,
        "Statistic": "Average",
        "Threshold": 80,
        "TreatMissingData": "notBreaching",
        "Tags": [
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    }
  },
  "Outputs": {
    "ApiEndpoint": {
      "Description": "Public API Gateway endpoint; LawOS application authentication remains mandatory",
      "Value": { "Fn::GetAtt": ["HttpApi", "ApiEndpoint"] }
    },
    "ApiFunctionArn": { "Value": { "Fn::GetAtt": ["ApiFunction", "Arn"] } },
    "AdminFunctionArn": { "Value": { "Fn::GetAtt": ["AdminFunction", "Arn"] } },
    "ApplicationDatabaseSecretArn": { "Value": { "Ref": "ApplicationDatabaseSecret" } },
    "DatabaseEndpoint": { "Value": { "Fn::GetAtt": ["Database", "Endpoint.Address"] } },
    "DmsBucketName": { "Value": { "Ref": "DmsBucket" } },
    "EntraConfigSecretArn": { "Value": { "Ref": "EntraConfigSecret" } },
    "StagingKmsKeyArn": { "Value": { "Fn::GetAtt": ["StagingKey", "Arn"] } },
    "VpcId": { "Value": { "Ref": "Vpc" } }
  }
}
