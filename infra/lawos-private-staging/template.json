      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "KmsKeyId": { "Fn::GetAtt": ["StagingKey", "Arn"] },
        "LogGroupName": "/aws/lambda/lawos-private-staging-admin",
        "RetentionInDays": 30,
        "Tags": [
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
