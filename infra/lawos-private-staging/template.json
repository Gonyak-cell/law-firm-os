{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated synthetic-only LawOS private staging. Does not modify or reuse AMIC Vault staging resources.",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "^lawos-private-staging/[0-9a-f]{40}/[0-9a-f]{64}\\.zip$"
    },
    "SourceSha": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{40}$"
    },
    "SourceTree": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{40}$"
    },
    "ArtifactSha256": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{64}$"
    },
    "OwnerInstructionSha256": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{64}$"
    },
    "Owner": {
      "Type": "String",
      "Default": "law-firm-os-owner",
      "AllowedPattern": "^[a-zA-Z0-9._@-]{3,64}$"
    },
    "ReviewDate": {
      "Type": "String",
      "Default": "2026-07-27",
      "AllowedPattern": "^2026-[0-9]{2}-[0-9]{2}$"
    },
    "ExpirationDate": {
      "Type": "String",
      "Default": "2026-08-31",
      "AllowedPattern": "^2026-[0-9]{2}-[0-9]{2}$"
    },
    "AllowedOrigins": {
      "Type": "String",
      "Default": "https://lawos-private-staging.invalid"
    },
    "EnableLambdaEniBootstrap": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["true", "false"],
      "Description": "Requires a separate narrow owner approval. Set true only while VPC ENIs are initially attached; update to false immediately afterward."
    }
  },
  "Conditions": {
    "LambdaEniBootstrapEnabled": {
      "Fn::Equals": [{ "Ref": "EnableLambdaEniBootstrap" }, "true"]
    }
  },
  "Mappings": {
    "Network": {
      "Cidrs": {
        "Vpc": "10.96.0.0/16",
        "PublicA": "10.96.0.0/24",
        "AppA": "10.96.10.0/24",
        "AppB": "10.96.11.0/24",
        "DbA": "10.96.20.0/24",
        "DbB": "10.96.21.0/24"
      }
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": { "Fn::FindInMap": ["Network", "Cidrs", "Vpc"] },
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "InstanceTenancy": "default",
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-egress" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "InternetGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "InternetGatewayId": { "Ref": "InternetGateway" },
        "VpcId": { "Ref": "Vpc" }
      }
    },
    "PublicSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "AvailabilityZone": { "Fn::Select": [0, { "Fn::GetAZs": "" }] },
        "CidrBlock": { "Fn::FindInMap": ["Network", "Cidrs", "PublicA"] },
        "MapPublicIpOnLaunch": false,
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-egress-a" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "AppSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "AvailabilityZone": { "Fn::Select": [0, { "Fn::GetAZs": "" }] },
        "CidrBlock": { "Fn::FindInMap": ["Network", "Cidrs", "AppA"] },
        "MapPublicIpOnLaunch": false,
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-app-a" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "AppSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "AvailabilityZone": { "Fn::Select": [1, { "Fn::GetAZs": "" }] },
        "CidrBlock": { "Fn::FindInMap": ["Network", "Cidrs", "AppB"] },
        "MapPublicIpOnLaunch": false,
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-app-b" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "DbSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "AvailabilityZone": { "Fn::Select": [0, { "Fn::GetAZs": "" }] },
        "CidrBlock": { "Fn::FindInMap": ["Network", "Cidrs", "DbA"] },
        "MapPublicIpOnLaunch": false,
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-db-a" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "DbSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "AvailabilityZone": { "Fn::Select": [1, { "Fn::GetAZs": "" }] },
        "CidrBlock": { "Fn::FindInMap": ["Network", "Cidrs", "DbB"] },
        "MapPublicIpOnLaunch": false,
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-db-b" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-public" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "PublicDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "InternetGatewayAttachment",
      "Properties": {
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": { "Ref": "InternetGateway" },
        "RouteTableId": { "Ref": "PublicRouteTable" }
      }
    },
    "PublicRouteTableAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "SubnetId": { "Ref": "PublicSubnetA" }
      }
    },
    "NatEip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "InternetGatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-nat" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": { "Fn::GetAtt": ["NatEip", "AllocationId"] },
        "ConnectivityType": "public",
        "SubnetId": { "Ref": "PublicSubnetA" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-nat" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "AppRouteTableA": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-app-a" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "AppRouteTableB": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-app-b" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "AppDefaultRouteA": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": { "Ref": "NatGateway" },
        "RouteTableId": { "Ref": "AppRouteTableA" }
      }
    },
    "AppDefaultRouteB": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": { "Ref": "NatGateway" },
        "RouteTableId": { "Ref": "AppRouteTableB" }
      }
    },
    "AppRouteTableAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "AppRouteTableA" },
        "SubnetId": { "Ref": "AppSubnetA" }
      }
    },
    "AppRouteTableAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "AppRouteTableB" },
        "SubnetId": { "Ref": "AppSubnetB" }
      }
    },
    "DbRouteTableA": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-db-a-isolated" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "DbRouteTableB": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-db-b-isolated" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "DbRouteTableAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "DbRouteTableA" },
        "SubnetId": { "Ref": "DbSubnetA" }
      }
    },
    "DbRouteTableAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "DbRouteTableB" },
        "SubnetId": { "Ref": "DbSubnetB" }
      }
    },
    "S3GatewayEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "RouteTableIds": [{ "Ref": "AppRouteTableA" }, { "Ref": "AppRouteTableB" }],
        "ServiceName": { "Fn::Sub": "com.amazonaws.${AWS::Region}.s3" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-s3" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ],
        "VpcEndpointType": "Gateway",
        "VpcId": { "Ref": "Vpc" }
      }
    },
    "LambdaSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "LawOS private staging Lambda egress",
        "GroupName": "lawos-private-staging-lambda",
        "SecurityGroupEgress": [
          {
            "Description": "TLS egress to Entra and AWS public endpoints through staging NAT",
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-lambda" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "LawOS private staging PostgreSQL ingress",
        "GroupName": "lawos-private-staging-postgres",
        "SecurityGroupEgress": [],
        "VpcId": { "Ref": "Vpc" },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-postgres" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "DatabaseIngressFromLambda": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "PostgreSQL only from LawOS staging Lambda",
        "FromPort": 5432,
        "GroupId": { "Fn::GetAtt": ["DatabaseSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": { "Fn::GetAtt": ["LambdaSecurityGroup", "GroupId"] },
        "ToPort": 5432
      }
    },
    "LambdaEgressToDatabase": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "Description": "PostgreSQL only to LawOS staging RDS",
        "DestinationSecurityGroupId": { "Fn::GetAtt": ["DatabaseSecurityGroup", "GroupId"] },
        "FromPort": 5432,
        "GroupId": { "Fn::GetAtt": ["LambdaSecurityGroup", "GroupId"] },
        "IpProtocol": "tcp",
        "ToPort": 5432
      }
    },
    "StagingKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "LawOS private staging RDS, S3, and Secrets Manager key",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "EnableAccountIamAuthority",
              "Effect": "Allow",
              "Principal": { "AWS": { "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root" } },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Sid": "AllowRegionalCloudWatchLogsEncryption",
              "Effect": "Allow",
              "Principal": { "Service": { "Fn::Sub": "logs.${AWS::Region}.amazonaws.com" } },
              "Action": ["kms:Encrypt", "kms:Decrypt", "kms:ReEncrypt*", "kms:GenerateDataKey*", "kms:DescribeKey"],
              "Resource": "*",
              "Condition": {
                "ArnLike": {
                  "kms:EncryptionContext:aws:logs:arn": { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/lawos-private-staging-*" }
                }
              }
            }
          ]
        },
        "PendingWindowInDays": 30,
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "StagingKeyAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": "alias/lawos-private-staging",
        "TargetKeyId": { "Ref": "StagingKey" }
      }
    },
    "DatabaseSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Isolated LawOS private staging database subnets",
        "DBSubnetGroupName": "lawos-private-staging-db",
        "SubnetIds": [{ "Ref": "DbSubnetA" }, { "Ref": "DbSubnetB" }],
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-db" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "DatabaseParameterGroup": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "TLS and audit logging for LawOS private staging",
        "Family": "postgres16",
        "Parameters": {
          "rds.force_ssl": "1",
          "log_connections": "1",
          "log_disconnections": "1",
          "log_statement": "ddl",
          "log_min_duration_statement": "1000"
        },
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-postgres16" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "AllocatedStorage": "20",
        "AllowMajorVersionUpgrade": false,
        "AutoMinorVersionUpgrade": false,
        "BackupRetentionPeriod": 7,
        "CopyTagsToSnapshot": true,
        "DBInstanceClass": "db.t4g.micro",
        "DBInstanceIdentifier": "lawos-private-staging-postgres",
        "DBName": "lawos",
        "DBParameterGroupName": { "Ref": "DatabaseParameterGroup" },
        "DBSubnetGroupName": { "Ref": "DatabaseSubnetGroup" },
        "DeletionProtection": true,
        "DeleteAutomatedBackups": false,
        "EnableCloudwatchLogsExports": ["postgresql", "upgrade"],
        "EnableIAMDatabaseAuthentication": false,
        "Engine": "postgres",
        "EngineVersion": "16.13",
        "KmsKeyId": { "Fn::GetAtt": ["StagingKey", "Arn"] },
        "ManageMasterUserPassword": true,
        "MasterUsername": "lawos_admin",
        "MasterUserSecret": { "KmsKeyId": { "Fn::GetAtt": ["StagingKey", "Arn"] } },
        "MaxAllocatedStorage": 40,
        "MultiAZ": false,
        "Port": 5432,
        "PreferredBackupWindow": "17:00-17:30",
        "PreferredMaintenanceWindow": "sun:18:00-sun:18:30",
        "PubliclyAccessible": false,
        "StorageEncrypted": true,
        "StorageType": "gp3",
        "VPCSecurityGroups": [{ "Fn::GetAtt": ["DatabaseSecurityGroup", "GroupId"] }],
        "Tags": [
          { "Key": "Name", "Value": "lawos-private-staging-postgres" },
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "ApplicationDatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Structured least-privilege LawOS staging application database credential",
        "GenerateSecretString": {
          "ExcludeCharacters": "\"'@/\\",
          "GenerateStringKey": "password",
          "PasswordLength": 48,
          "SecretStringTemplate": "{\"username\":\"lawos_app\",\"configuration_state\":\"pending_admin_bootstrap\"}"
        },
        "KmsKeyId": { "Fn::GetAtt": ["StagingKey", "Arn"] },
        "Name": "/lawos/private-staging/postgres/application",
        "Tags": [
          { "Key": "environment", "Value": "lawos-staging" },
