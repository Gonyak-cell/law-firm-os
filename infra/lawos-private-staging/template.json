        ]
      }
    },
    "ApiExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }]
        },
        "Description": "Dedicated least-privilege LawOS private staging API role",
        "Policies": [
          {
            "PolicyName": "lawos-private-staging-api-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "WriteExactApiLogGroup",
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/lawos-private-staging-api:*" }
                },
                {
                  "Sid": "ReadExactRuntimeSecrets",
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    { "Ref": "ApplicationDatabaseSecret" },
                    { "Ref": "TenantContextSecret" },
                    { "Ref": "SessionSecret" },
                    { "Ref": "PayrollArtifactSecret" },
                    { "Ref": "EntraConfigSecret" },
                    { "Ref": "ProviderCredentialReferenceSecret" }
                  ]
                },
                {
                  "Sid": "UseExactStagingKey",
                  "Effect": "Allow",
                  "Action": ["kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:DescribeKey"],
                  "Resource": { "Fn::GetAtt": ["StagingKey", "Arn"] }
                },
                {
                  "Sid": "ReadExactDmsBucket",
                  "Effect": "Allow",
                  "Action": ["s3:GetBucketLocation", "s3:GetBucketObjectLockConfiguration", "s3:GetBucketVersioning", "s3:ListBucket", "s3:ListBucketVersions"],
                  "Resource": { "Fn::GetAtt": ["DmsBucket", "Arn"] }
                },
                {
                  "Sid": "OperateExactDmsObjects",
                  "Effect": "Allow",
                  "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:GetObject", "s3:GetObjectLegalHold", "s3:GetObjectRetention", "s3:GetObjectVersion", "s3:PutObject", "s3:PutObjectLegalHold", "s3:PutObjectRetention"],
                  "Resource": { "Fn::Sub": "${DmsBucket.Arn}/lawos-dms/*" }
                },
                {
                  "Sid": "DenyFunctionCodeEc2Networking",
                  "Effect": "Deny",
                  "Action": ["ec2:CreateNetworkInterface", "ec2:DescribeNetworkInterfaces", "ec2:DescribeSubnets", "ec2:DeleteNetworkInterface", "ec2:DetachNetworkInterface", "ec2:AssignPrivateIpAddresses", "ec2:UnassignPrivateIpAddresses"],
                  "Resource": "*",
                  "Condition": { "ArnEquals": { "lambda:SourceFunctionArn": { "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:lawos-private-staging-api" } } }
                }
              ]
            }
          }
        ],
        "RoleName": "lawos-private-staging-api-role",
        "Tags": [
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "AdminExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }]
        },
        "Description": "Dedicated direct-invoke LawOS private staging migration role",
        "Policies": [
          {
            "PolicyName": "lawos-private-staging-admin-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "WriteExactAdminLogGroup",
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/lawos-private-staging-admin:*" }
                },
                {
                  "Sid": "ReadExactBootstrapSecrets",
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    { "Fn::GetAtt": ["Database", "MasterUserSecret.SecretArn"] },
                    { "Ref": "ApplicationDatabaseSecret" },
                    { "Ref": "TenantContextSecret" },
                    { "Ref": "SyntheticManifestSecret" }
                  ]
                },
                {
                  "Sid": "PopulateExactApplicationSecret",
                  "Effect": "Allow",
                  "Action": "secretsmanager:PutSecretValue",
                  "Resource": { "Ref": "ApplicationDatabaseSecret" }
                },
                {
                  "Sid": "UseExactStagingKey",
                  "Effect": "Allow",
                  "Action": ["kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:DescribeKey"],
                  "Resource": { "Fn::GetAtt": ["StagingKey", "Arn"] }
                },
                {
                  "Sid": "DenyFunctionCodeEc2Networking",
                  "Effect": "Deny",
                  "Action": ["ec2:CreateNetworkInterface", "ec2:DescribeNetworkInterfaces", "ec2:DescribeSubnets", "ec2:DeleteNetworkInterface", "ec2:DetachNetworkInterface", "ec2:AssignPrivateIpAddresses", "ec2:UnassignPrivateIpAddresses"],
                  "Resource": "*",
                  "Condition": { "ArnEquals": { "lambda:SourceFunctionArn": { "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:lawos-private-staging-admin" } } }
                }
              ]
            }
          }
        ],
        "RoleName": "lawos-private-staging-admin-role",
        "Tags": [
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "LambdaVpcEniBootstrapPolicy": {
      "Type": "AWS::IAM::Policy",
      "Condition": "LambdaEniBootstrapEnabled",
      "Properties": {
        "PolicyName": "lawos-private-staging-lambda-vpc-eni-bootstrap-temporary",
        "Roles": [{ "Ref": "ApiExecutionRole" }, { "Ref": "AdminExecutionRole" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "LambdaVpcEniBootstrap",
              "Effect": "Allow",
              "Action": ["ec2:CreateNetworkInterface", "ec2:DescribeNetworkInterfaces", "ec2:DescribeSubnets", "ec2:DeleteNetworkInterface", "ec2:AssignPrivateIpAddresses", "ec2:UnassignPrivateIpAddresses"],
              "Resource": "*"
            }
          ]
        }
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": ["ApiLogGroup", "LambdaVpcEniBootstrapPolicy"],
      "Properties": {
        "Architectures": ["arm64"],
        "Code": { "S3Bucket": { "Ref": "ArtifactBucket" }, "S3Key": { "Ref": "ArtifactKey" } },
        "Description": "Exact-head LawOS private staging API; synthetic-only",
        "Environment": {
          "Variables": {
            "LAWOS_API_ALLOWED_ORIGINS": { "Ref": "AllowedOrigins" },
            "LAWOS_API_SESSION_SECRET_SECRET_ID": { "Ref": "SessionSecret" },
            "LAWOS_AWS_REGION": { "Ref": "AWS::Region" },
            "LAWOS_DEPLOYMENT_ARTIFACT_SHA256": { "Ref": "ArtifactSha256" },
            "LAWOS_DEPLOYMENT_COMMIT": { "Ref": "SourceSha" },
            "LAWOS_DEPLOYMENT_TREE": { "Ref": "SourceTree" },
            "LAWOS_DMS_S3_BUCKET": { "Ref": "DmsBucket" },
            "LAWOS_DMS_S3_CREDENTIAL_REF": { "Ref": "ProviderCredentialReferenceSecret" },
            "LAWOS_DMS_S3_DEFAULT_RETENTION_DAYS": "7",
            "LAWOS_DMS_S3_EXPECTED_BUCKET_OWNER": { "Ref": "AWS::AccountId" },
            "LAWOS_DMS_S3_KMS_KEY_ID": { "Fn::GetAtt": ["StagingKey", "Arn"] },
            "LAWOS_DMS_S3_OBJECT_LOCK_ENABLED": "true",
            "LAWOS_DMS_S3_PREFIX": "lawos-dms",
            "LAWOS_DMS_S3_REGION": { "Ref": "AWS::Region" },
            "LAWOS_ENTRA_OIDC_CONFIG_SECRET_ID": { "Ref": "EntraConfigSecret" },
            "LAWOS_PAYROLL_ARTIFACT_KEY_SECRET_ID": { "Ref": "PayrollArtifactSecret" },
            "LAWOS_PERSISTENCE_AUTHORITY": "postgres-v2",
            "LAWOS_POSTGRES_SSL_MODE": "verify-full",
            "LAWOS_POSTGRES_TENANT_CONTEXT_SECRET_ID": { "Ref": "TenantContextSecret" },
            "LAWOS_POSTGRES_URL_SECRET_ID": { "Ref": "ApplicationDatabaseSecret" },
            "LAWOS_RUNTIME_PROFILE": "operational",
            "NODE_EXTRA_CA_CERTS": "/var/task/certs/global-bundle.pem"
          }
        },
        "FunctionName": "lawos-private-staging-api",
        "Handler": "apps/api/src/lambda.handler",
        "KmsKeyArn": { "Fn::GetAtt": ["StagingKey", "Arn"] },
        "MemorySize": 1024,
        "ReservedConcurrentExecutions": 10,
        "Role": { "Fn::GetAtt": ["ApiExecutionRole", "Arn"] },
        "Runtime": "nodejs22.x",
        "Timeout": 30,
        "VpcConfig": {
          "Ipv6AllowedForDualStack": false,
          "SecurityGroupIds": [{ "Fn::GetAtt": ["LambdaSecurityGroup", "GroupId"] }],
          "SubnetIds": [{ "Ref": "AppSubnetA" }, { "Ref": "AppSubnetB" }]
        },
        "Tags": [
          { "Key": "environment", "Value": "lawos-staging" },
          { "Key": "system", "Value": "lawos" },
          { "Key": "owner", "Value": { "Ref": "Owner" } },
          { "Key": "review", "Value": { "Ref": "ReviewDate" } },
          { "Key": "expiration", "Value": { "Ref": "ExpirationDate" } }
        ]
      }
    },
    "AdminFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": ["AdminLogGroup", "LambdaVpcEniBootstrapPolicy"],
      "Properties": {
        "Architectures": ["arm64"],
        "Code": { "S3Bucket": { "Ref": "ArtifactBucket" }, "S3Key": { "Ref": "ArtifactKey" } },
