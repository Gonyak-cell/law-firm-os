        "Name": "lawos-private-staging",
        "ProtocolType": "HTTP",
        "Tags": {
          "environment": "lawos-staging",
          "system": "lawos",
          "owner": { "Ref": "Owner" },
          "review": { "Ref": "ReviewDate" },
          "expiration": { "Ref": "ExpirationDate" }
        }
      }
