      "allowed_source_trees",
      "allowed_versions",
      "allowed_roles",
      "allowed_operations",
      "allowed_artifact_sha256s",
      "allowed_binding_sha256s"
    ],
    "required_receipt_binding_fields": [
      "source_sha",
      "source_tree",
      "version",
      "pilot_id",
      "lawos_tenant_id",
      "entra_tenant_id",
      "artifact_sha256",
      "binding_sha256",
      "role",
      "operation"
    ]
  },
  "status": "governance_contract",
  "scope": {
    "release_track": "named_external_law_firm_pilot",
    "evidence_only": true,
    "provider_calls_allowed": false,
    "source_of_truth_position": "independent_fail_closed_external_release_matrix",
    "does_not_replace": [
      "production_ready",
      "go_live_approval",
      "provider_deployment",
      "human_or_legal_approval"
    ]
  },
  "claim_policy": {
    "external_pilot_distribution_approved_by_validator": false,
    "production_cutover_executed_by_validator": false,
    "go_live_claim_by_validator": false,
    "file_presence_is_evidence": false,
    "pending_external_inputs_count_as_proof": false
  },
  "runtime_admission": {
    "current_runtime_mode": "single_tenant_env_binding",
    "tenant_environment_variable": "LAWOS_IDENTITY_TENANT_ID",
    "database_tenant_environment_variable": "LAWOS_DATABASE_TENANT_ID",
    "federated_tenant_source": "resolved_oidc_protected_config",
    "issuer_strategy": "https://login.microsoftonline.com/{entra_tenant_id}/v2.0",
    "provisioning_receipt_alone_satisfies_runtime_binding": false,
    "allowed_runtime_receipts": [
      "tenant_pinned_runtime_binding",
      "multi_tenant_runtime_review"
    ],
    "multi_tenant_review_requirements": [
      "review_status_APPROVED",
      "per_request_tenant_and_issuer_validation",
      "isolation_negative_tests_PASS",
      "independent_review_reference"
    ]
