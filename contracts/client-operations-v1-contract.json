        "crm.inquiry.evidence.read",
        "crm.engagement.decide",
        "outlook.connection.manage",
        "outlook.inquiry.capture",
        "finance.fee.write",
        "analytics.client.read",
        "analytics.client.export"
      ]
    },
    "existing_bank_scope_assignments_expanded_by_this_contract": false,
    "object_access_trimmed_before_aggregation": true
  },
  "dashboard": {
    "kpis": {
      "new_inquiries": "current_count",
      "consultations_today": "asia_seoul_today_incomplete_count",
      "engagement_reviews": "current_pending_decision_count",
      "deposit_revenue_month": "current_month_period_flow",
      "receivables_total": "current_as_of_balance"
    },
    "charts": [
      "monthly_deposit_revenue_last_12_months",
